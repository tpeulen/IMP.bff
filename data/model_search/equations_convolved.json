{
 "schema": "bff.model_search.v1",
 "family": "equations_convolved",
 "title": "Equations of time convolved with a measured response",
 "presentation": {
  "_comment": "Generic over the equations: the catalogue supplies them; this frame adds the response convolution and the counting instrument. Read by applications, ignored by the engine.",
  "groups": {
   "equation": "Parameters",
   "instrument": "Instrument"
  },
  "datasets": {
   "decay": {
    "label": "Decay",
    "primary": true
   },
   "response": {
    "label": "IRF",
    "required_unless": "generated_response"
   },
   "linearization": {
    "label": "Lin. table"
   },
   "background_pattern": {
    "label": "Background"
   },
   "linearization_curve": {
    "label": "DNL measurement"
   }
  },
  "scalars": {
   "period": {
    "label": "Period [ns]",
    "default": 12.5
   },
   "periodic": {
    "label": "Periodic excitation",
    "kind": "flag"
   },
   "autoscale": {
    "label": "Autoscale n0",
    "kind": "flag"
   },
   "pile_up": {
    "label": "Pile-up",
    "kind": "flag"
   },
   "dead_time": {
    "label": "Dead time [ns]"
   },
   "measurement_time": {
    "label": "Measurement time [s]"
   },
   "response_start": {
    "label": "IRF start [ns]"
   },
   "response_stop": {
    "label": "IRF stop [ns]"
   },
   "t_background": {
    "label": "t(background) [s]"
   },
   "t_decay": {
    "label": "t(decay) [s]"
   },
   "shift_background": {
    "label": "Shift background with IRF",
    "kind": "flag"
   },
   "generated_response": {
    "label": "Model the IRF (no measured IRF)",
    "kind": "flag"
   },
   "lin_window_length": {
    "label": "DNL window [channels]"
   },
   "lin_window": {
    "label": "DNL window (0 flat, 1 hanning, 2 hamming, 3 bartlett, 4 blackman)"
   },
   "reverse_linearization": {
    "label": "Reverse DNL table",
    "kind": "flag"
   }
  }
 },
 "datasets": [
  "decay"
 ],
 "optional_datasets": [
  "response",
  "linearization",
  "background_pattern",
  "linearization_curve"
 ],
 "scalars": [
  "period"
 ],
 "optional_scalars": {
  "periodic": 0,
  "autoscale": 0,
  "pile_up": 0,
  "dead_time": 0.0,
  "measurement_time": 1.0,
  "fit_start": 0,
  "fit_stop": 1e+18,
  "response_start": 0.0,
  "response_stop": 1e+18,
  "t_background": 1.0,
  "t_decay": 1.0,
  "shift_background": 1,
  "generated_response": 0,
  "lin_window_length": 17,
  "lin_window": 1,
  "reverse_linearization": 0
 },
 "parameters": {
  "instrument.scatter": {
   "name": "scatter",
   "group": "instrument",
   "initial": 0.0,
   "free": false,
   "lower": 0.0,
   "upper": 1.0
  },
  "instrument.background": {
   "name": "background",
   "group": "instrument",
   "initial": "decay_min",
   "lower": 0.0,
   "upper": "decay_max"
  },
  "instrument.n0": {
   "name": "n0",
   "group": "instrument",
   "initial": 1.0,
   "free": false,
   "lower": 0.0,
   "upper": null
  },
  "instrument.timeshift": {
   "name": "timeshift",
   "group": "instrument",
   "initial": 0.0,
   "free": false,
   "lower": "-0.5*decay_size",
   "upper": "0.5*decay_size"
  },
  "instrument.response_background": {
   "name": "lamp background",
   "group": "instrument",
   "initial": 0.0,
   "free": false,
   "lower": 0.0,
   "upper": "decay_max"
  },
  "instrument.irf_width": {
   "name": "irf width",
   "group": "instrument",
   "initial": 0.1,
   "free": false,
   "lower": 0.0001,
   "upper": "decay_size*decay_dx"
  },
  "instrument.irf_shape": {
   "name": "irf shape",
   "group": "instrument",
   "initial": -0.31,
   "free": false,
   "lower": -10.0,
   "upper": 10.0
  },
  "instrument.irf_position": {
   "name": "irf position",
   "group": "instrument",
   "initial": "decay_rise_index*decay_dx",
   "free": false,
   "lower": 0.0,
   "upper": "decay_size*decay_dx"
  }
 },
 "structures": {},
 "equations": {
  "dataset": "decay",
  "expression_node": "model",
  "moves": "all",
  "structure": {
   "nodes": {
    "generated_response": {
     "type": "GeneralizedNormalCurve",
     "config": {
      "floor": 1.0
     },
     "config_rules": {
      "n_points": "decay_size",
      "dt": "decay_dx",
      "area": "decay_sum"
     },
     "inputs": {
      "loc": "#instrument.irf_position",
      "scale": "#instrument.irf_width",
      "shape": "#instrument.irf_shape"
     },
     "outputs": {
      "@name": "float_vector"
     }
    },
    "model": {
     "type": "GraphExpression",
     "inputs": {},
     "outputs": {
      "@name": "float_vector"
     }
    },
    "convolved": {
     "type": "Convolution",
     "config_rules": {
      "mode": {
       "options": [
        "causal",
        "periodic"
       ],
       "index": "periodic"
      },
      "period": "period/decay_dx",
      "response_range": [
       "max(0,floor(response_start/decay_dx))",
       "min(decay_size,floor(response_stop/decay_dx))"
      ],
      "response_from_port": "generated_response"
     },
     "bind": {
      "response": "response"
     },
     "inputs": {
      "curve": "model",
      "timeshift": "#instrument.timeshift",
      "response_background": "#instrument.response_background",
      "response": "generated_response"
     },
     "outputs": {
      "@name": "float_vector"
     }
    },
    "decay": {
     "type": "TCSPCDecay",
     "config": {
      "curve_from_port": true
     },
     "config_rules": {
      "timing": [
       "decay_dx",
       "period"
      ],
      "scale_range": [
       "fit_start",
       "min(decay_size,fit_stop)"
      ],
      "autoscale": "autoscale",
      "pile_up": "pile_up",
      "pile_up_parameters": [
       "dead_time",
       "measurement_time"
      ],
      "response_range": [
       "max(0,floor(response_start/decay_dx))",
       "min(decay_size,floor(response_stop/decay_dx))"
      ],
      "background_times": [
       "t_background",
       "t_decay"
      ],
      "shift_background_with_response": "shift_background",
      "response_from_port": "generated_response",
      "linearization_smoothing": [
       "lin_window_length",
       "fit_start",
       "min(decay_size,fit_stop)",
       "reverse_linearization"
      ],
      "linearization_window": {
       "options": [
        "flat",
        "hanning",
        "hamming",
        "bartlett",
        "blackman"
       ],
       "index": "lin_window"
      }
     },
     "bind": {
      "response": "response",
      "data": "decay",
      "linearization": "linearization",
      "background_pattern": "background_pattern",
      "linearization_curve": "linearization_curve"
     },
     "inputs": {
      "curve": "convolved",
      "scatter": "#instrument.scatter",
      "background": "#instrument.background",
      "n0": "#instrument.n0",
      "timeshift": "#instrument.timeshift",
      "response_background": "#instrument.response_background",
      "response": "generated_response"
     },
     "outputs": {
      "@name": "float_vector"
     }
    },
    "objective": {
     "type": "FitChiSquared",
     "bind": {
      "data": "decay"
     },
     "inputs": {
      "model": "decay"
     },
     "outputs": {
      "@name": "float",
      "residuals": "float_vector"
     }
    }
   },
   "objective": "objective",
   "free": [
    "instrument.background"
   ],
   "ess": "decay_size",
   "selection": "bic"
  }
 }
}
