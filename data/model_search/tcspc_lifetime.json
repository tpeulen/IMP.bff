   "upper": 1.0
  },
  "lifetime.tau.0": {
   "name": "t0",
   "initial": "min(period,max(dt,1))",
   "lower": "max(dt*0.01,1e-12)",
   "upper": "period"
  },
  "lifetime.amplitude.1": {
   "name": "a1",
   "initial": 0.5,
   "lower": 0.0,
