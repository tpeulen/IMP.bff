{
 "schema": "bff.model_search.v1",
 "family": "tcspc_lifetime",
 "title": "TCSPC: a multi-exponential decay through a measured response",
 "datasets": [
  "decay",
  "response"
 ],
 "scalars": [
  "dt",
  "period"
 ],
 "optional_scalars": {
  "autoscale": 0,
  "pile_up": 0,
  "dead_time": 0.0,
  "measurement_time": 1.0,
  "amplitude_threshold": 0.0,
  "convolution_stop": 1e+18,
  "scale_stop": 1e+18
 },
 "optional_datasets": [
  "linearization"
 ],
 "axes": {
  "n": {
   "from": 1,
   "to": 3
  }
 },
 "parameters": {
  "repeat": {
   "index": "i",
   "count": "n_max",
   "body": {
    "lifetime.amplitude.{i}": {
     "name": "a{i}",
     "initial": "1/({i}+1)",
     "lower": 0.0,
     "upper": 1.0
    },
    "lifetime.tau.{i}": {
     "name": "t{i}",
     "initial": "min(period,max(dt,{i}+1))",
     "lower": "max(dt*0.01,1e-12)",
     "upper": "period"
    }
   }
  },
  "instrument.scatter": {
   "name": "scatter",
   "initial": 0.0,
   "free": false,
   "lower": 0.0,
   "upper": 1.0
  },
  "instrument.background": {
   "name": "background",
   "initial": "decay_min",
   "lower": 0.0,
   "upper": "decay_max"
  },
  "instrument.n0": {
   "name": "n0",
   "initial": "decay_sum",
   "lower": 0.0,
   "upper": "100*decay_sum"
  },
  "instrument.timeshift": {
   "name": "timeshift",
   "initial": 0.0,
   "free": false,
   "lower": "-0.5*response_size",
   "upper": "0.5*response_size"
  }
 },
 "initial_axes": {
  "n": 1
 },
 "template": {
  "key": "lifetime.components.{n}",
  "nodes": {
   "decay": {
    "type": "TCSPCDecay",
    "config": {
     "number_of_lifetimes": "{n}",
     "normalize_amplitudes": true,
     "absolute_amplitudes": true
    },
    "config_rules": {
     "timing": [
      "dt",
      "period"
     ],
     "convolution_range": [
      "decay_size",
      "min(decay_size,convolution_stop)"
     ],
     "scale_range": [
      0,
      "min(decay_size,scale_stop)"
     ],
     "autoscale": "autoscale",
     "pile_up": "pile_up",
     "pile_up_parameters": [
      "dead_time",
      "measurement_time"
     ],
     "amplitude_threshold": "amplitude_threshold"
    },
    "bind": {
     "response": "response",
     "data": "decay",
     "linearization": "linearization"
    },
    "inputs": {
     "repeat": {
      "index": "i",
      "count": "n",
      "body": {
       "a{i}": "#lifetime.amplitude.{i}",
       "t{i}": "#lifetime.tau.{i}"
      }
     },
     "scatter": "#instrument.scatter",
     "background": "#instrument.background",
     "n0": "#instrument.n0",
     "timeshift": "#instrument.timeshift"
    },
    "outputs": {
     "@name": "float_vector"
    }
   },
   "objective": {
    "type": "FitChiSquared",
    "bind": {
     "data": "decay"
    },
    "inputs": {
     "model": "decay"
    },
    "outputs": {
     "@name": "float",
     "residuals": "float_vector"
    }
   }
  },
  "objective": "objective",
  "free": [
   {
    "each": {
     "index": "i",
     "from": 1,
     "count": "n",
     "body": "lifetime.amplitude.{i}"
    }
   },
   {
    "each": {
     "index": "i",
     "count": "n",
     "body": "lifetime.tau.{i}"
    }
   },
   "instrument.scatter",
   "instrument.background",
   "instrument.n0",
   "instrument.timeshift"
  ],
  "initial": {
   "repeat": {
    "index": "i",
    "count": "n_max",
    "body": {
     "lifetime.amplitude.{i}": "1/{n}"
    }
   }
  },
  "ess": "decay_size",
  "selection": "bic",
  "starts": [
   {
    "repeat": {
     "index": "i",
     "count": "n_max",
     "body": {
      "lifetime.tau.{i}": "max(dt*2,period/(2*4**({n}-1-{i})))"
     }
    }
   },
   {
    "repeat": {
     "index": "i",
     "count": "n_max",
     "body": {
      "lifetime.tau.{i}": "max(dt*2,period/(2*12**({n}-1-{i})))"
     }
    }
   }
  ]
 },
 "moves": [
  {
   "action": "stop",
   "prior": 0.25,
   "terminal": true
  },
  {
   "action": "add-component",
   "axis": "n",
   "delta": 1,
   "prior": 0.5
  },
  {
   "action": "remove-component",
   "axis": "n",
   "delta": -1,
   "prior": 0.25
  }
 ]
}
