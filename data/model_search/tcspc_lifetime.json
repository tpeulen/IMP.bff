   "initial": 0.0,
   "lower": 0.0,
   "upper": "decay_max"
  },
  "instrument.n0": {
   "name": "n0",
   "initial": "decay_sum",
   "lower": 0.0,
   "upper": "100*decay_sum"
  },
  "instrument.timeshift": {
   "name": "timeshift",
   "initial": 0.0,
   "free": false,
   "lower": "-0.5*response_size",
   "upper": "0.5*response_size"
  }
 },
