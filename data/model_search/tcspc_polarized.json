{
 "schema": "bff.model_search.v1",
 "family": "tcspc_polarized",
 "title": "Lifetime: polarized",
 "presentation": {
  "_comment": "How an application presents this family. Read by applications, ignored by the engine.",
  "groups": {
   "lifetimes": "Lifetimes",
   "rotations": "Rotations",
   "anisotropy": "Anisotropy",
   "instrument": "Instrument"
  },
  "datasets": {
   "decay": {
    "label": "Decay",
    "primary": true
   },
   "response": {
    "label": "IRF",
    "required_unless": "generated_response"
   },
   "linearization": {
    "label": "Lin. table"
   },
   "background_pattern": {
    "label": "Background"
   },
   "linearization_curve": {
    "label": "DNL measurement"
   }
  },
  "scalars": {
   "dt": {
    "label": "dt [ns]",
    "default": "decay_dx"
   },
   "period": {
    "label": "Period [ns]",
    "default": 12.5
   },
   "max_components": {
    "label": "Most lifetime components"
   },
   "autoscale": {
    "label": "Autoscale n0",
    "kind": "flag"
   },
   "pile_up": {
    "label": "Pile-up",
    "kind": "flag"
   },
   "dead_time": {
    "label": "Dead time [ns]"
   },
   "measurement_time": {
    "label": "Measurement time [s]"
   },
   "response_start": {
    "label": "IRF start [ns]"
   },
   "response_stop": {
    "label": "IRF stop [ns]"
   },
   "t_background": {
    "label": "t(background) [s]"
   },
   "t_decay": {
    "label": "t(decay) [s]"
   },
   "shift_background": {
    "label": "Shift background with IRF",
    "kind": "flag"
   },
   "periodic_excitation": {
    "label": "Periodic excitation",
    "kind": "flag"
   },
   "convolve": {
    "label": "Convolve with IRF",
    "kind": "flag"
   },
   "generated_response": {
    "label": "Model the IRF (no measured IRF)",
    "kind": "flag"
   },
   "polarization": {
    "label": "Polarization (0 VM, 1 VV, 2 VH, 3 VV/VH)"
   },
   "lin_window_length": {
    "label": "DNL window [channels]"
   },
   "lin_window": {
    "label": "DNL window (0 flat, 1 hanning, 2 hamming, 3 bartlett, 4 blackman)"
   },
   "reverse_linearization": {
    "label": "Reverse DNL table",
    "kind": "flag"
   }
  },
  "distributions": {
   "lifetime_spectrum": {
    "label": "Lifetime",
    "node": "spectrum",
    "port": "@name"
   }
  },
  "statistics": {
   "tau_species": {
    "label": "<tau>x",
    "of": "lifetime_spectrum",
    "statistic": "species_averaged_lifetime"
   },
   "tau_fluorescence": {
    "label": "<tau>F",
    "of": "lifetime_spectrum",
    "statistic": "fluorescence_averaged_lifetime"
   }
  },
  "reference_modes": [
   "tcspc_total_photons",
   "tcspc_peak_photons"
  ],
  "axis": {
   "x": "time (ns)",
   "y": "counts",
   "scale_y": "log"
  }
 },
 "datasets": [
  "decay"
 ],
 "scalars": [
  "dt",
  "period"
 ],
 "optional_scalars": {
  "max_components": 3,
  "autoscale": 0,
  "pile_up": 0,
  "dead_time": 0.0,
  "measurement_time": 1.0,
  "amplitude_threshold": 0.0,
  "convolution_stop": 1e+18,
  "scale_stop": 1e+18,
  "response_start": 0.0,
  "response_stop": 1e+18,
  "t_background": 1.0,
  "t_decay": 1.0,
  "shift_background": 1,
  "periodic_excitation": 1,
  "convolve": 1,
  "generated_response": 0,
  "polarization": 1,
  "fit_start": 0,
  "fit_stop": 1e+18,
  "lin_window_length": 17,
  "lin_window": 1,
  "reverse_linearization": 0
 },
 "optional_datasets": [
  "response",
  "linearization",
  "background_pattern",
  "linearization_curve"
 ],
 "axes": {
  "n": {
   "from": 1,
   "to": "max_components"
  },
  "m": {
   "from": 1,
   "to": 2
  }
 },
 "parameters": {
  "repeat": [
   {
    "index": "i",
    "count": "n_max",
    "body": {
     "lifetime.amplitude.{i}": {
      "name": "a{i}",
      "initial": "1/({i}+1)",
      "lower": 0.0,
      "upper": null,
      "group": "lifetimes"
     },
     "lifetime.tau.{i}": {
      "name": "t{i}",
      "initial": "min(period,max(dt,{i}+1))",
      "lower": "max(dt*0.01,1e-12)",
      "upper": "period",
      "group": "lifetimes"
     }
    }
   },
   {
    "index": "j",
    "count": "m_max",
    "body": {
     "rotation.amplitude.{j}": {
      "name": "b{j}",
      "initial": "1/({j}+1)",
      "lower": 0.0,
      "upper": 1.0,
      "group": "rotations"
     },
     "rotation.time.{j}": {
      "name": "rho{j}",
      "initial": "min(period,max(dt,{j}+1))",
      "lower": "max(dt*0.01,1e-12)",
      "upper": "period",
      "group": "rotations"
     }
    }
   }
  ],
  "anisotropy.r0": {
   "name": "r0",
   "initial": 0.38,
   "lower": 0.0,
   "upper": 0.4,
   "group": "anisotropy"
  },
  "anisotropy.g": {
   "name": "g",
   "initial": 1.0,
   "free": false,
   "lower": 0.1,
   "upper": 10.0,
   "group": "anisotropy"
  },
  "anisotropy.l1": {
   "name": "l1",
   "initial": 0.0308,
   "free": false,
   "lower": 0.0,
   "upper": 1.0,
   "group": "anisotropy"
  },
  "anisotropy.l2": {
   "name": "l2",
   "initial": 0.0368,
   "free": false,
   "lower": 0.0,
   "upper": 1.0,
   "group": "anisotropy"
  },
  "instrument.scatter": {
   "name": "scatter",
   "initial": 0.0,
   "free": false,
   "lower": 0.0,
   "upper": 1.0,
   "group": "instrument"
  },
  "instrument.background": {
   "name": "background",
   "initial": "decay_min",
   "lower": 0.0,
   "upper": "decay_max",
   "group": "instrument"
  },
  "instrument.n0": {
   "name": "n0",
   "initial": "decay_sum",
   "lower": 0.0,
   "upper": "100*decay_sum",
   "group": "instrument"
  },
  "instrument.timeshift": {
   "name": "timeshift",
   "initial": 0.0,
   "free": false,
   "lower": "-0.5*decay_size",
   "upper": "0.5*decay_size",
   "group": "instrument"
  },
  "instrument.response_background": {
   "name": "lamp background",
   "group": "instrument",
   "initial": 0.0,
   "free": false,
   "lower": 0.0,
   "upper": "decay_max"
  },
  "instrument.irf_width": {
   "name": "irf width",
   "group": "instrument",
   "initial": 0.1,
   "free": false,
   "lower": 0.0001,
   "upper": "decay_size*dt"
  },
  "instrument.irf_shape": {
   "name": "irf shape",
   "group": "instrument",
   "initial": -0.31,
   "free": false,
   "lower": -10.0,
   "upper": 10.0
  },
  "instrument.irf_position": {
   "name": "irf position",
   "group": "instrument",
   "initial": "decay_rise_index*dt",
   "free": false,
   "lower": 0.0,
   "upper": "decay_size*dt"
  }
 },
 "initial_axes": {
  "n": 1,
  "m": 1
 },
 "template": {
  "key": "lifetime.components.{n}.rotations.{m}",
  "nodes": {
   "generated_response": {
    "type": "GeneralizedNormalCurve",
    "config": {
     "floor": 1.0
    },
    "config_rules": {
     "n_points": "decay_size",
     "dt": "dt",
     "area": "decay_sum"
    },
    "inputs": {
     "loc": "#instrument.irf_position",
     "scale": "#instrument.irf_width",
     "shape": "#instrument.irf_shape"
    },
    "outputs": {
     "@name": "float_vector"
    }
   },
   "spectrum": {
    "type": "PhotophysicsLifetimeSpectrumNode",
    "config": {
     "number_of_lifetimes": "{n}",
     "normalize_amplitudes": true
    },
    "inputs": {
     "repeat": {
      "index": "i",
      "count": "n",
      "body": {
       "a{i}": "#lifetime.amplitude.{i}",
       "t{i}": "#lifetime.tau.{i}"
      }
     }
    },
    "outputs": {
     "@name": "float_vector"
    }
   },
   "polarized": {
    "type": "PhotophysicsAnisotropySpectrumNode",
    "config": {
     "number_of_rotations": "{m}"
    },
    "config_rules": {
     "polarization": {
      "options": [
       "VM",
       "VV",
       "VH",
       "VV/VH"
      ],
      "index": "polarization"
     }
    },
    "inputs": {
     "lifetime_spectrum": "spectrum",
     "repeat": {
      "index": "j",
      "count": "m",
      "body": {
       "b{j}": "#rotation.amplitude.{j}",
       "rho{j}": "#rotation.time.{j}"
      }
     },
     "r0": "#anisotropy.r0",
     "g": "#anisotropy.g",
     "l1": "#anisotropy.l1",
     "l2": "#anisotropy.l2"
    },
    "outputs": {
     "@name": "float_vector"
    }
   },
   "decay": {
    "type": "TCSPCDecay",
    "config": {
     "instrument_units": "counts",
     "number_of_lifetimes": "{n}",
     "spectrum_from_port": true
    },
    "config_rules": {
     "timing": [
      "dt",
      "period"
     ],
     "convolution_range": [
      "decay_size",
      "min(decay_size,convolution_stop)"
     ],
     "scale_range": [
      0,
      "min(decay_size,scale_stop)"
     ],
     "autoscale": "autoscale",
     "pile_up": "pile_up",
     "pile_up_parameters": [
      "dead_time",
      "measurement_time"
     ],
     "amplitude_threshold": "amplitude_threshold",
     "response_range": [
      "max(0,floor(response_start/dt))",
      "min(decay_size,floor(response_stop/dt))"
     ],
     "background_times": [
      "t_background",
      "t_decay"
     ],
     "shift_background_with_response": "shift_background",
     "convolution_mode": {
      "options": [
       "single",
       "periodic"
      ],
      "index": "periodic_excitation"
     },
     "convolve": "convolve",
     "response_from_port": "generated_response",
     "linearization_smoothing": [
      "lin_window_length",
      "fit_start",
      "min(decay_size,fit_stop)",
      "reverse_linearization"
     ],
     "linearization_window": {
      "options": [
       "flat",
       "hanning",
       "hamming",
       "bartlett",
       "blackman"
      ],
      "index": "lin_window"
     }
    },
    "bind": {
     "response": "response",
     "data": "decay",
     "linearization": "linearization",
     "background_pattern": "background_pattern",
     "linearization_curve": "linearization_curve"
    },
    "inputs": {
     "lifetime_spectrum": "polarized",
     "scatter": "#instrument.scatter",
     "background": "#instrument.background",
     "n0": "#instrument.n0",
     "timeshift": "#instrument.timeshift",
     "response_background": "#instrument.response_background",
     "response": "generated_response"
    },
    "outputs": {
     "@name": "float_vector",
     "fluorescence_total": "float"
    }
   },
   "objective": {
    "type": "FitChiSquared",
    "bind": {
     "data": "decay"
    },
    "inputs": {
     "model": "decay"
    },
    "outputs": {
     "@name": "float",
     "residuals": "float_vector"
    }
   }
  },
  "objective": "objective",
  "free": [
   {
    "each": {
     "index": "i",
     "from": 1,
     "count": "n",
     "body": "lifetime.amplitude.{i}"
    }
   },
   {
    "each": {
     "index": "i",
     "count": "n",
     "body": "lifetime.tau.{i}"
    }
   },
   {
    "each": {
     "index": "j",
     "from": 1,
     "count": "m",
     "body": "rotation.amplitude.{j}"
    }
   },
   {
    "each": {
     "index": "j",
     "count": "m",
     "body": "rotation.time.{j}"
    }
   },
   "anisotropy.r0",
   "instrument.scatter",
   "instrument.background",
   "instrument.n0",
   "instrument.timeshift"
  ],
  "initial": {
   "repeat": {
    "index": "i",
    "count": "n_max",
    "body": {
     "lifetime.amplitude.{i}": "1/{n}"
    }
   }
  },
  "ess": "decay_size",
  "selection": "bic",
  "starts": [
   {
    "repeat": {
     "index": "i",
     "count": "n_max",
     "body": {
      "lifetime.tau.{i}": "max(dt*2,period/(2*4**({n}-1-{i})))"
     }
    }
   },
   {
    "repeat": {
     "index": "i",
     "count": "n_max",
     "body": {
      "lifetime.tau.{i}": "max(dt*2,period/(2*12**({n}-1-{i})))"
     }
    }
   }
  ],
  "label": "{n} lifetime(s), {m} rotation(s)"
 },
 "moves": [
  {
   "action": "stop",
   "prior": 0.25,
   "terminal": true
  },
  {
   "action": "add-lifetime",
   "axis": "n",
   "delta": 1,
   "prior": 0.5
  },
  {
   "action": "remove-lifetime",
   "axis": "n",
   "delta": -1,
   "prior": 0.25
  },
  {
   "action": "add-rotation",
   "axis": "m",
   "delta": 1,
   "prior": 0.5
  },
  {
   "action": "remove-rotation",
   "axis": "m",
   "delta": -1,
   "prior": 0.25
  }
 ],
 "outputs": {
  "lifetime_spectrum": {
   "node": "decay",
   "port": "spectrum"
  },
  "fluorescence_total": {
   "node": "decay",
   "port": "fluorescence_total"
  }
 }
}
