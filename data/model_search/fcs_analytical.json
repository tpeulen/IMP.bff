  "fcs.2d.1diff.0relax": {
   "nodes": {
    "model": {
     "type": "GraphExpression",
     "config": {
      "expression": "b+1/abs(N)*((1+x/abs(td1))**(-1))"
     },
     "inputs": {
      "x": "@curve.axis",
      "N": "#fcs.N",
      "b": "#fcs.baseline",
      "td1": "#fcs.diffusion_time.1"
     },
     "outputs": {
      "@name": "float_vector"
     }
    },
    "chi2": {
     "type": "FitChiSquared",
     "bind": {
      "data": "curve"
     },
     "inputs": {
      "model": "model"
     },
     "outputs": {
      "@name": "float",
      "residuals": "float_vector"
     }
    }
   },
   "objective": "chi2",
   "free": [
    "fcs.N",
    "fcs.baseline",
    "fcs.diffusion_time.1"
