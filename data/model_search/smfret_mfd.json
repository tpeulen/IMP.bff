{
 "schema": "bff.model_search.v1",
 "family": "smfret_mfd",
 "title": "smFRET / MFD: donor and acceptor decays of selected bursts",
 "_comment": "Multiparameter fluorescence detection: the donor (DD) and acceptor (DA) channel decays under donor excitation, from the bursts a selection kept, fitted jointly. FRET species share their quenched donor lifetimes and fractions across both channels; the DA channel sees them as donor-shaped crosstalk. The acceptor term adds a component at the acceptor lifetime to DA (direct excitation and the late tail of sensitized emission). Its lifetime is only identifiable with the acceptor seen on its own (AA, acceptor excitation), so the move that adds it requires decay_aa: without it the search answers request_information rather than guessing. The AA decay, when bound, is fitted in every topology alike (its lifetime on its own until the acceptor term couples it into DA), so every topology is scored on the same data; an unbound AA has no points, so the sample size counts it either way.",
 "datasets": [
  "decay_dd",
  "decay_da",
  "response"
 ],
 "optional_datasets": [
  "decay_aa"
 ],
 "dataset_kinds": {
  "decay_dd": "burst_mfd",
  "decay_da": "burst_mfd",
  "decay_aa": "burst_mfd"
 },
 "scalars": [
  "dt",
  "period"
 ],
 "optional_scalars": {
  "max_species": 2
 },
 "axes": {
  "n": {
   "from": 1,
   "to": "max_species"
  },
  "d": {
   "from": 0,
   "to": 1
  }
 },
 "parameters": {
  "repeat": {
   "index": "i",
   "count": "n_max",
   "body": {
    "fret.amplitude.{i}": {
     "name": "x{i}",
     "initial": "1/({i}+1)",
     "lower": 0.0,
     "upper": null,
     "group": "species"
    },
    "fret.tau.{i}": {
     "name": "tau{i}",
     "initial": "min(period,max(dt,3.2/(1+2.5*{i})))",
     "lower": "max(dt*0.01,1e-12)",
     "upper": "period",
     "group": "species"
    }
   }
  },
  "acceptor.tau": {
   "name": "tau(A)",
   "initial": "min(period,max(dt,1.6))",
   "lower": "max(dt*0.01,1e-12)",
   "upper": "period",
   "group": "acceptor"
  },
  "crosstalk.direct": {
   "name": "direct",
   "initial": 1.0,
   "lower": 0.0,
   "upper": 10.0,
   "group": "acceptor"
  },
  "decay_dd.background": {
   "name": "bg(DD)",
   "initial": "decay_dd_min",
   "lower": 0.0,
   "upper": "decay_dd_max",
   "group": "background"
  },
  "decay_da.background": {
   "name": "bg(DA)",
   "initial": "decay_da_min",
   "lower": 0.0,
   "upper": "decay_da_max",
   "group": "background"
  },
  "decay_aa.background": {
   "name": "bg(AA)",
   "initial": 0.0,
   "lower": 0.0,
   "upper": "decay_dd_max+decay_da_max+1",
   "group": "background"
  }
 },
 "initial_axes": {
  "n": 1,
  "d": 0
 },
 "template": {
  "key": "smfret_mfd.species.{n}.acceptor.{d}",
  "nodes": {
   "dd": {
    "type": "TCSPCDecay",
    "config": {
     "instrument_units": "counts",
     "autoscale": true,
     "normalize_amplitudes": true,
     "absolute_amplitudes": true
    },
    "config_rules": {
     "number_of_lifetimes": "{n}",
     "timing": [
      "dt",
      "period"
     ],
     "convolution_range": [
      "decay_dd_size",
      "decay_dd_size"
     ],
     "scale_range": [
      0,
      "decay_dd_size"
     ]
    },
    "bind": {
     "response": "response",
     "data": "decay_dd"
    },
    "inputs": {
     "repeat": {
      "index": "i",
      "count": "n",
      "body": {
       "a{i}": "#fret.amplitude.{i}",
       "t{i}": "#fret.tau.{i}"
      }
     },
     "background": "#decay_dd.background"
    },
    "outputs": {
     "@name": "float_vector"
    }
   },
   "dd_fit": {
    "type": "FitChiSquared",
    "bind": {
     "data": "decay_dd"
    },
    "inputs": {
     "model": "dd"
    },
    "outputs": {
     "@name": "float",
     "residuals": "float_vector"
    }
   },
   "da": {
    "type": "TCSPCDecay",
    "config": {
     "instrument_units": "counts",
     "autoscale": true,
     "normalize_amplitudes": true,
     "absolute_amplitudes": true
    },
    "config_rules": {
     "number_of_lifetimes": "{n}+{d}",
     "timing": [
      "dt",
      "period"
     ],
     "convolution_range": [
      "decay_da_size",
      "decay_da_size"
     ],
     "scale_range": [
      0,
      "decay_da_size"
     ]
    },
    "bind": {
     "response": "response",
     "data": "decay_da"
    },
    "inputs": {
     "repeat": [
      {
       "index": "i",
       "count": "n",
       "body": {
        "a{i}": "#fret.amplitude.{i}",
        "t{i}": "#fret.tau.{i}"
       }
      },
      {
       "index": "k",
       "count": "d",
       "body": {
        "a{n}": "#crosstalk.direct",
        "t{n}": "#acceptor.tau"
       }
      }
     ],
     "background": "#decay_da.background"
    },
    "outputs": {
     "@name": "float_vector"
    }
   },
   "da_fit": {
    "type": "FitChiSquared",
    "bind": {
     "data": "decay_da"
    },
    "inputs": {
     "model": "da"
    },
    "outputs": {
     "@name": "float",
     "residuals": "float_vector"
    }
   },
   "aa": {
    "type": "TCSPCDecay",
    "config": {
     "instrument_units": "counts",
     "autoscale": true,
     "normalize_amplitudes": true,
     "absolute_amplitudes": true
    },
    "config_rules": {
     "number_of_lifetimes": "1",
     "timing": [
      "dt",
      "period"
     ],
     "convolution_range": [
      "decay_aa_size",
      "decay_aa_size"
     ],
     "scale_range": [
      0,
      "decay_aa_size"
     ]
    },
    "bind": {
     "response": "response",
     "data": "decay_aa"
    },
    "inputs": {
     "a0": "#fret.amplitude.0",
     "t0": "#acceptor.tau",
     "background": "#decay_aa.background"
    },
    "outputs": {
     "@name": "float_vector"
    },
    "when_bound": "decay_aa"
   },
   "aa_fit": {
    "type": "FitChiSquared",
    "bind": {
     "data": "decay_aa"
    },
    "inputs": {
     "model": "aa"
    },
    "outputs": {
     "@name": "float",
     "residuals": "float_vector"
    },
    "when_bound": "decay_aa"
   },
   "joint": {
    "type": "FitJointChiSquared",
    "members": [
     "dd_fit",
     "da_fit",
     {
      "member": "aa_fit",
      "when_bound": "decay_aa"
     }
    ],
    "outputs": {
     "@name": "float",
     "residuals": "float_vector"
    }
   }
  },
  "objective": "joint",
  "free": [
   {
    "each": {
     "index": "i",
     "from": 1,
     "count": "n",
     "body": "fret.amplitude.{i}"
    }
   },
   {
    "each": {
     "index": "i",
     "count": "n",
     "body": "fret.tau.{i}"
    }
   },
   "decay_dd.background",
   "decay_da.background",
   {
    "each": {
     "index": "k",
     "count": "d",
     "body": "crosstalk.direct"
    }
   },
   {
    "parameter": "acceptor.tau",
    "when_bound": "decay_aa"
   },
   {
    "parameter": "decay_aa.background",
    "when_bound": "decay_aa"
   }
  ],
  "ess": "decay_dd_size+decay_da_size+decay_aa_size",
  "selection": "bic",
  "acceptable_above": 0.001,
  "label": "{n} FRET species, acceptor {d}"
 },
 "moves": [
  {
   "action": "stop",
   "prior": 0.25,
   "terminal": true
  },
  {
   "action": "add-species",
   "axis": "n",
   "delta": 1,
   "prior": 0.35
  },
  {
   "action": "remove-species",
   "axis": "n",
   "delta": -1,
   "prior": 0.15
  },
  {
   "action": "add-acceptor-term",
   "axis": "d",
   "delta": 1,
   "prior": 0.15,
   "requires": [
    "decay_aa"
   ]
  },
  {
   "action": "drop-acceptor-term",
   "axis": "d",
   "delta": -1,
   "prior": 0.1
  }
 ]
}
