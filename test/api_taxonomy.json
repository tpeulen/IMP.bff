  "investigations": {
    "States": "Retained: exposes general weighted point clouds, distance statistics, and non-probe callers; probe-only ownership is not established.",
    "GaussianDistances and PolymerDistances": "Retain scientific names in independent headers; generic distributions, not photophysics.",
    "ImpBffComputeBackend": "C ABI struct and plugin entry symbol retained; filename changes only, layout/version unchanged.",
    "Quenching": "Explicit Photophysics rename row takes precedence over later generic keep-list.",
    "molecularprobesimulation": "Exact molecular header/topic row takes precedence over stale explicitprobesimulation mention.",
    "RmfIO": "Retained: the explicit map defers RMF acronym changes to an IMP-wide pass.",
    "RotamerScoring": "Keep consolidated orchestration: masks, LJ parameter assembly and weighting are shared by topology/restraint consumers; no separate ownership boundary warrants another split.",
    "FftLength and Rebin": "No production include consumers were found; moved to include/internal as directed.",
    "Header-only rename rows": "Existing specific kernel/function spellings are retained when the plan names only a header; explicit primary-type renames and ProbeRotamer family splits are recorded in symbols."
  }
